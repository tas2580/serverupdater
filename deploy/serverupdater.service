[Unit]
Description=ServerUpdater Debian monitoring and package updates
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/serverupdaterd run --config /etc/serverupdater/config.json
Restart=on-failure
RestartSec=5
UMask=0077
# The daemon waits for active package operations on SIGTERM. Do not signal dpkg.
KillMode=process
TimeoutStopSec=infinity

[Install]
WantedBy=multi-user.target
